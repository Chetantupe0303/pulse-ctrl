{
  "name": "pulse-ctrl",
  "version": "1.0.0",
  "description": "Local Wi-Fi phone trackpad and keyboard for your laptop",
  "scripts": {
    "start": "node server/index.js",
    "start:server": "node server/index.js",
    "server": "node server/index.js",
    "start:helper": "node helper/index.js",
    "helper": "node helper/index.js",
    "dev": "concurrently -k \"npm run start:server\" \"npm run start:helper\"",
    "test": "node test/end-to-end-test.js",
    "test:lifecycle": "node test/reconnect-test.js"
  },
  "dependencies": {
    "@nut-tree/nut-js": "npm:@nut-tree-fork/nut-js@^4.2.6",
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "keywords": [
    "trackpad",
    "keyboard",
    "remote-control",
    "websocket",
    "qr-pairing"
  ],
  "license": "MIT"
}
